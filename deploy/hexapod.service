# Hexapod control server. Installed by deploy/install.sh, which fills in @USER@ and @REPO@.
#
# This one process owns the serial port, the i2c bus and the camera. Nothing
# else on the Pi should open them while it runs; the status panel and the
# laptop client are plain HTTP clients of it.
[Unit]
Description=Hexapod control server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
SupplementaryGroups=dialout i2c video
WorkingDirectory=@REPO@
ExecStart=@REPO@/.venv/bin/hexapod serve --host 0.0.0.0 --port 8000
Restart=always
RestartSec=2
Environment=PYTHONUNBUFFERED=1
# Latch the e-stop first: the relay opens before anything else happens. The
# leading - lets the stop go ahead when the server is already down.
ExecStop=-/usr/bin/curl -fsS -m 2 -X POST http://127.0.0.1:8000/stop
# Then SIGINT. The server gives open connections 2 s and runs board.close(),
# which sends torque off again. A SIGKILL at 10 s skips all of that and leaves
# the relay as it was, because the watchdog lives in this process.
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
